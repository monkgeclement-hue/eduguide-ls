AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Optional fallback provider.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o

# Persistent production backend. Leave DATA_BACKEND=auto for local SQLite fallback.
DATA_BACKEND=auto
SUPABASE_URL=replace_with_your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=eduguide-documents

# Server-created system admin. Do not commit real secrets.
ADMIN_NAME=replace_with_admin_name
ADMIN_EMAIL=replace_with_admin_email
ADMIN_PASSWORD=replace_with_admin_password
ADMIN_DISTRICT=replace_with_admin_district
ADMIN_PHONE=replace_with_admin_phone

# Email one-time-code verification for public registration.
# For local development only, EMAIL_DEBUG_CODES=true returns the code in the API response.
EMAIL_DEBUG_CODES=false
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_EMAIL=replace_with_verified_sender_email
SMTP_FROM_NAME=EduGuide LS
SMTP_USE_TLS=true
SMTP_USE_SSL=false
